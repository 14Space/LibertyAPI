# Скопируй этот файл в .env и заполни две первые строки.

# Токен от @BotFather
BOT_TOKEN=

# Твой тег в Telegram, без @. Этот человек будет админом.
ADMIN_USERNAME=

# Проект Bionic, где виден чат админа и откуда его можно продолжить на ноутбуке.
# Если оставить пустым, чаты хранятся только в боте.
BIONIC_PROJECT=

# Дальше необязательные настройки, значения по умолчанию подобраны под этот ноутбук.

# Модель при первом запуске. Потом выбирается через /setmodel.
# DEFAULT_MODEL=qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive

# Размер контекста модели в токенах. Чем больше, тем больше расход памяти.
# CONTEXT_LENGTH=16384

# Минимум места под ответ в токенах. Обычно модель получает всё свободное место
# контекста и не обрывается; этот запас ей гарантирован всегда.
# REPLY_MAX_TOKENS=4096

# Рассуждения модели перед ответом. none выключает их, и ответы идут намного быстрее.
# С пустым значением они включатся, но могут съесть весь лимит и оставить ответ пустым.
# REASONING_EFFORT=none

# Потолок для пересказа старой части диалога.
# SUMMARY_MAX_TOKENS=3000

# Через сколько минут простоя выгружать модель из памяти. 0 значит не выгружать.
# История чатов лежит в базе и при выгрузке не теряется.
# IDLE_UNLOAD_MINUTES=5

# Адрес сервера Bionic и путь к утилите lms.
# LM_BASE_URL=http://127.0.0.1:1234
# LMS_PATH=C:\Users\G16St\.lmstudio\bin\lms.exe
